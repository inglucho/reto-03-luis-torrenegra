# Variables requeridas, sin valores (copiar a .env y completar). Nunca subir .env al repositorio.

# Proveedor de lenguaje: gemini (capa gratuita de Google AI Studio) o anthropic
LLM_PROVIDER=gemini
# Opcional: si se deja vacío se usa el modelo por defecto del proveedor
# (gemini-3.5-flash para gemini, con respaldo automático a gemini-3.5-flash-lite y gemini-3.1-flash-lite;
#  claude-opus-5-5 para anthropic)
LLM_MODEL=
# Clave del proveedor: solo para el chat. demo.ts y los tests no la usan.
# Gemini: se obtiene gratis en https://aistudio.google.com/apikey
LLM_API_KEY=

# Límites de costo y robustez
LLM_TIMEOUT_MS=120000
MAX_ITERACIONES=25
MAX_TOKENS_SESION=500000

PORT=3000
