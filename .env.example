# Variables del agente. Copia este archivo a .env y completa lo necesario.
# Nunca subas .env al repositorio. Solo LLM_API_KEY es obligatoria, y solo para el chat:
# demo.ts y los tests no usan ninguna clave.

# Proveedor de lenguaje: gemini (capa gratuita de Google AI Studio) o anthropic. Vacío = gemini.
LLM_PROVIDER=
# Modelo. Vacío = el predeterminado del proveedor
# (gemini-3.5-flash con respaldo a gemini-3.5-flash-lite y gemini-3.1-flash-lite; claude-opus-5-5).
LLM_MODEL=
# Clave del proveedor. Gemini: se obtiene gratis en https://aistudio.google.com/apikey
LLM_API_KEY=

# Límites de costo y robustez. Vacío = valor por defecto.
# Tiempo máximo de espera al proveedor, en milisegundos (120000).
LLM_TIMEOUT_MS=
# Rondas herramienta → modelo por turno (25).
MAX_ITERACIONES=
# Tokens por conversación (500000).
MAX_TOKENS_SESION=
# Tokens por día para todo el servidor, porque el link es público (3000000).
MAX_TOKENS_DIA=
# Mensajes por IP en cada ventana de minutos (30 cada 10).
MAX_MENSAJES_POR_IP=
VENTANA_MINUTOS=

# Fecha de referencia del negocio (vigencias, fechas de registro). Vacío = hoy.
# 2026-09-03 (fecha de los PRD) reproduce el escenario de la prueba.
FECHA_REFERENCIA=

# Puerto HTTP (3000).
PORT=
